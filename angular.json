{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "3664e6e7-a29e-4f55-8ffb-ecf53cf10ede"
  },
  "newProjectRoot": "projects",
  "projects": {
    "imperium-bank": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/imperium-bank",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": [
              "zone.js"
            ],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              "src/assets"
            ],
            "styles": [
              "src/assets/shared.css",
              "src/assets/index-style.css",
              "src/assets/login-style.css",
              "src/assets/register-style.css",
              "src/assets/profile-style.css",
              "src/assets/operations-style.css",
              "src/assets/loan-style.css",
              "src/assets/service-style.css",
              "src/assets/accounts-style.css",
              "src/assets/user-movements-style.css",
              "src/assets/user-cards-style.css",
              "src/assets/sidebar-style.css",
              "src/assets/responsive-style.css",
              "src/assets/responsive-pages.css",
              "src/styles.css"
            ],
            "scripts": []
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "imperium-bank:build:production"
            },
            "development": {
              "buildTarget": "imperium-bank:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular-devkit/build-angular:extract-i18n"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ],
            "tsConfig": "tsconfig.spec.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/assets/shared.css",
              "src/assets/index-style.css",
              "src/assets/login-style.css",
              "src/assets/register-style.css",
              "src/assets/profile-style.css",
              "src/assets/operations-style.css",
              "src/assets/loan-style.css",
              "src/assets/service-style.css",
              "src/assets/accounts-style.css",
              "src/assets/user-movements-style.css",
              "src/assets/user-cards-style.css",
              "src/assets/sidebar-style.css",
              "src/assets/responsive-style.css",
              "src/assets/responsive-pages.css",
              "src/styles.css"
            ],
            "scripts": []
          }
        }
      }
    }
  }
}
